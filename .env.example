# Copy to .env and paste your OpenRouter key (you add this yourself).
# Get a key: https://openrouter.ai/keys
EXPO_PUBLIC_OPENROUTER_API_KEY=
# Text / voice
EXPO_PUBLIC_AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Meal photo vision (must support images)
EXPO_PUBLIC_AI_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
EXPO_PUBLIC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
